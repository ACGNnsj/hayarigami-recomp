// Adapted from MacNativeGames games/totk/runtime/movie_host.c @ b75be8cf (MIT, Copyright (c) 2026 MacNativeGames
// contributors).
// movie::Decoder on the host: VP9 with libvpx (BSD-3-Clause, linked statically), AVC/H.264 Annex B with the inbox
// Media Foundation decoder.
// XC2's pre-rendered movies (stream/movie/*.webm, 154 files: VP9 1280x720 with a Vorbis track) play through the SDK
// movie library in subsdk0, Android's MediaCodec over NVIDIA NvMM. Its video decoder opens NVDEC through NvRm, whose
// first NvOsDrvOpen aborts with "Use of nv::InitializeGraphics is required." because ov_gfx.c takes
// nv::InitializeGraphics over; nvdrv and mm:u are not served either. The game's own demuxer (movie::Extractor) runs as
// guest code; only the video decoder is replaced. The Vorbis track's decoder (type 5) stays the library's SoftVorbis,
// which runs on the CPU and constructs without NvRm.
// main imports the constructor and calls the decoder through the vtable for movie::Decoder, whose slots are ABS64
// relocations by name: the HOST_OVERRIDE entries below replace them. A VP9 decoder (type 3; XC2's SDK 3.5 library has
// buffer mode only, see ov_ctor) is a host object, +0 the library's vtable, +8 the host Movie (where the library keeps
// its DecoderImpl); any other decoder runs the original code. Behaviour follows DecoderImpl:
// - output format 3 (movie.h MOVIE_FORMAT_NV12) is packed NV12 (Y plane, then interleaved UV; stride = width), copied
//   into the client's Buffer;
// - input and output buffers are indices handed out FIFO, as MediaCodec does; input flag 4 / output flag 4 = end of stream;
// - client events {input available, output available, format changed, error} (DecoderEvents, 4 EventType pointers) are
//   signalled with nn::os::SignalEvent on a guest thread.
// Decoding runs on one host worker thread per decoder (libvpx adds its own tile threads), never on the game's threads:
// SendInputBufferForDecode queues the input and returns. Events the worker owes (input free, format changed, error) are
// signalled at the next entry call or present, whichever comes first.
// Pacing: the game shows one decoded frame per game frame, which plays a 30 fps movie at 30 fps only at 30 fps. So
// decoded frames are handed over when their presentation time is due, counted from the first frame (movie_tick, at every
// present on the presenting guest thread), at most one per present. When the game falls behind, a frame more than 1.5
// periods late is dropped if the next one is due too, so the picture keeps time with the movie's sound.
// XC2_MOVIE_PACE=0 hands every decoded frame over at the next present; XC2_MOVIE_HOST=0 leaves every decoder to the
// library (which aborts at the first movie).
#include <emmintrin.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#include <vpx/vp8dx.h>
#include <vpx/vpx_decoder.h>

#include <mfapi.h>
#include <mferror.h>
#include <mfidl.h>
#include <mftransform.h>
#include <objbase.h>
// CLSID_CMSH264DecoderMFT ({62CE7E72-4C71-4D20-B15D-452831A87D9D}, verified in HKCR), defined here: the GUID is absent from
// libmfuuid.a (which holds only the older CLSID_MSH264DecoderMFT).
static const GUID MF_CLSID_H264_DECODER = { 0x62ce7e72, 0x4c71, 0x4d20, { 0xb1, 0x5d, 0x45, 0x28, 0x31, 0xa8, 0x7d, 0x9d } };

#include "cfg.h"
#include "host.h"
#include "movie.h"
#include "platform/platform.h"

enum { IN_BUFS = 4, IN_CAP = 2 << 20, OUT_BUFS = 8, MAX_MOVIES = 16, VPX_THREADS = 4 };
enum { ST_OK = 0, ST_ERROR = 0x1000, ST_NULL = 0x100b, ST_NO_OUTPUT = 0x100e, ST_NO_INPUT = 0x1011,
       ST_UNSUPPORTED = 0x2001, ST_NOT_CONFIGURED = 0x2002 };

const char *const movie_symbols[MOVIE_ENTRIES] = {
    "_ZN5movie7DecoderC1ENS_11DecoderTypeENS_19DecoderOutputFormatE", "_ZN5movie7DecoderD2Ev",
    "_ZN5movie7DecoderD0Ev", "_ZN5movie7Decoder9ConfigureEPNS_9MediaDataE",
    "_ZN5movie7Decoder20RegisterClientEventsEPNS_13DecoderEventsE", "_ZN5movie7Decoder15GetOutputFormatEPNS_9MediaDataE",
    "_ZN5movie7Decoder5StartEv", "_ZN5movie7Decoder4StopEv", "_ZN5movie7Decoder5ResetEv", "_ZN5movie7Decoder5FlushEv",
    "_ZN5movie7Decoder23AcquireInputBufferIndexEPiS1_", "_ZN5movie7Decoder14GetInputBufferEiPNS_6BufferE",
    "_ZN5movie7Decoder24SendInputBufferForDecodeEiiilj", "_ZN5movie7Decoder24AcquireOutputBufferIndexEPiPlPjS1_",
    "_ZN5movie7Decoder15GetOutputBufferEiPNS_6BufferE", "_ZN5movie7Decoder19GetOutputBufferSizeEPiS1_",
    "_ZN5movie7Decoder24ReleaseOutputBufferIndexEi", "_ZN5movie7Decoder12GetLastErrorEv",
    "_ZN5movie7Decoder15GetOutputBufferEiPNS_6BufferEPNS_9MediaDataE",
    "_ZN5movie7Decoder21GetOutputBufferFormatEiPNS_9MediaDataE"};

// The constructor's signature differs between SDK versions: 3.5 takes (type, output format), 1.2.1/1.4.3 add a
// DecoderMode and a priority. Every spelling is hooked and resolved, so one table serves every title.
static const char *const movie_ctor_names[] = {
    "_ZN5movie7DecoderC1ENS_11DecoderTypeENS_19DecoderOutputFormatENS_11DecoderModeEi",
    "_ZN5movie7DecoderC1ENS_11DecoderTypeENS_19DecoderOutputFormatE", NULL};

typedef struct { int index; unsigned flags; int64_t time; } Ready;
typedef struct { int index, offset, size; int64_t time; unsigned flags; } Pending;
typedef struct {
    uint64_t guest;                          // the movie::Decoder object
    int format, configured, started, w, h, eos_in, format_sent, last_error;
    int stub, stub_fed;
    unsigned long long fed_in;               // video packets handed to the worker                       // no decoder: consume input, answer end of stream (see stub_on)
    uint64_t events;                         // guest DecoderEvents *: EventType * per MOVIE_EV_*
    vpx_codec_ctx_t vpx;
    int vpx_live;
    IMFTransform *mf;
    int mf_live, mf_is_avc, mf_ready, mf_broken, mf_have_sps, mf_have_pps, mf_pre, mf_thread_init, mf_warned;
    int mf_out_w, mf_out_h, mf_fed_first;   // geometry the decoder chose, and whether it has seen its first sample
    uint8_t *mf_seq;
    size_t mf_seq_len, mf_seq_cap;
    uint8_t *in[IN_BUFS];                    // kernel region: the game writes the compressed frames here
    int in_free[IN_BUFS], nin_free;
    Pending pending[IN_BUFS];                // sent, not decoded yet (the worker takes them in order)
    int npending;
    uint8_t *out[OUT_BUFS];                  // NV12 frames
    int out_bytes[OUT_BUFS], out_held[OUT_BUFS];
    Ready decoded[OUT_BUFS];                 // decoded, not due yet
    int ndecoded;
    Ready ready[OUT_BUFS];                   // handed over: AcquireOutputBufferIndex returns these
    int nready;
    unsigned owed;                           // events to signal on the next guest thread (bit per MOVIE_EV_*)
    uint64_t t0;                             // host time of the first frame handed over (pacing)
    int64_t pts0;                            // its presentation time (us)
    MovieStats st;
    PlatMutex mu;
    PlatCond work, idle;
    PlatThread *thread;
    int busy, quit;
    uint64_t gen;                            // bumped by Flush, Stop, Reset, destruction: a decode in flight is dropped
} Movie;

static MovieGuest G;
static volatile int32_t g_ready;
static PlatMutex g_init = PLAT_MUTEX_INIT;
static Movie *g_movies[MAX_MOVIES];
static volatile int32_t g_count;                // live host decoders: movie_tick returns at once when 0
static PlatMutex g_lock = PLAT_MUTEX_INIT;        // lock order: g_lock, then Movie.mu
static uint64_t (*g_clock)(void) = kern_now_ns;
static int g_pace = -1;

void movie_set_clock(uint64_t (*clock)(void)) { g_clock = clock ? clock : kern_now_ns; }
void movie_set_pace(int on) { g_pace = on; }
static int pace_on(void) {
    if (g_pace < 0) {
        const char *e = cfg_get("XC2_MOVIE_PACE");
        g_pace = !(e && !strcmp(e, "0"));
    }
    return g_pace;
}
// XC2_MOVIE_STUB (default 1): a decoder the host cannot run (AAC audio and the like) consumes its input and reports end of
// stream at once instead of calling the library, whose nn::codec hardware path the host has not implemented and which
// aborts. The movie is skipped; the game continues. 0 leaves such decoders to the library.
static int stub_on(void) {
    static int v = -1;
    if (v < 0) {
        const char *e = cfg_get("XC2_MOVIE_STUB");
        v = !(e && !strcmp(e, "0"));
    }
    return v;
}
static int host_off(void) {
    static int v = -1;
    if (v < 0) {
        const char *e = cfg_get("XC2_MOVIE_HOST");
        v = e && !strcmp(e, "0");
    }
    return v;
}

static uint64_t need(const char *name) {
    uint64_t a = ldr_symbol(name);
    if (!a) rt_fatal("movie: guest symbol %s is not loaded", name);
    return a;
}

static uint64_t need_any(const char *const *names) {   // the first spelling this title defines
    for (const char *const *p = names; *p; p++) {
        uint64_t a = ldr_symbol(*p);
        if (a) return a;
    }
    rt_fatal("movie: guest symbol %s is not loaded", names[0]);
    return 0;
}

// The guest functions, resolved the first time any entry runs (the modules are loaded and relocated by then).
static void guest_init(void) {
    if (g_ready) return;
    plat_mutex_lock(&g_init);
    if (!g_ready) {
        G.signal_event = need("_ZN2nn2os11SignalEventEPNS0_9EventTypeE");
        G.buf_set_range = need("_ZN5movie6Buffer8SetRangeEii");
        G.buf_set_data = need("_ZN5movie6Buffer18SetDataAndCapacityEPvm");
        G.buf_base = need("_ZNK5movie6Buffer4BaseEv");
        G.buf_capacity = need("_ZNK5movie6Buffer8CapacityEv");
        G.md_find_int32 = need("_ZNK5movie9MediaData9FindInt32EPKcPi");
        G.md_find_string = need("_ZNK5movie9MediaData10FindStringEPKcPS2_");
        G.md_set_int32 = need("_ZN5movie9MediaData8SetInt32EPKci");
        G.md_set_rect = need("_ZN5movie9MediaData7SetRectEPKciiii");
        G.md_set_string = need("_ZN5movie9MediaData9SetStringEPKcS2_");
        G.vptr = need("_ZTVN5movie7DecoderE") + 0x10;
        G.orig[MOVIE_CTOR] = need_any(movie_ctor_names);
        for (int i = MOVIE_CTOR + 1; i < MOVIE_ENTRIES; i++) G.orig[i] = need(movie_symbols[i]);
        plat_xchg32(&g_ready, 1);
    }
    plat_mutex_unlock(&g_init);
}

void movie_set_guest(const MovieGuest *g) {
    plat_mutex_lock(&g_init);
    G = *g;
    plat_xchg32(&g_ready, 1);
    plat_mutex_unlock(&g_init);
}

#define U(x) ((uint64_t)(uintptr_t)(x))
static void buf_set_range(Cpu *c, uint64_t b, int off, int n) { rt_call(c, G.buf_set_range, 3, b, (uint64_t)off, (uint64_t)n); }
static void buf_set_data(Cpu *c, uint64_t b, uint64_t p, uint64_t n) { rt_call(c, G.buf_set_data, 3, b, p, n); }
static int md_find_int32(Cpu *c, uint64_t md, const char *k, int *v) {
    return (uint8_t)rt_call(c, G.md_find_int32, 3, md, U(k), U(v));
}
static void md_set_int32(Cpu *c, uint64_t md, const char *k, int v) { rt_call(c, G.md_set_int32, 3, md, U(k), (uint64_t)(uint32_t)v); }

// The original code of an entry with the caller's arguments; its result stays in x0.
static void pass(Cpu *c, int which) {
    uint64_t a[8];
    memcpy(a, c->x, sizeof a);
    if (!G.orig[which]) rt_fatal("movie: no original code for %s", movie_symbols[which]);
    rt_call(c, G.orig[which], 8, a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]);
}

static Movie *find(uint64_t guest) {
    Movie *m = NULL;
    plat_mutex_lock_shared(&g_lock);
    for (int i = 0; i < MAX_MOVIES && !m; i++)
        if (g_movies[i] && g_movies[i]->guest == guest) m = g_movies[i];
    plat_mutex_unlock_shared(&g_lock);
    return m;
}

// Events are signalled after the locks are released: the woken game thread calls straight back in.
typedef struct { uint64_t ev[4 * MAX_MOVIES]; int n; } Signals;
static void collect(Movie *m, Signals *s) {   // m->mu held
    for (int k = 0; k < 4; k++)
        if (m->owed & (1u << k) && m->events && s->n < (int)(sizeof s->ev / sizeof *s->ev)) {
            uint64_t ev = LD64(m->events + 8 * (uint64_t)k);
            if (ev) s->ev[s->n++] = ev;
        }
    m->owed = 0;
}
static void fire(Cpu *c, const Signals *s) {
    for (int i = 0; i < s->n; i++) rt_call(c, G.signal_event, 1, s->ev[i]);
}

static int frame_bytes(const Movie *m) { return m->w * m->h + (m->w / 2) * (m->h / 2) * 2; }

// I420 (libvpx) -> packed NV12: Y rows, then rows of interleaved U, V.
static void to_nv12(const vpx_image_t *img, uint8_t *dst, int w, int h) {
    for (int y = 0; y < h; y++)
        memcpy(dst + (size_t)y * w, img->planes[VPX_PLANE_Y] + (size_t)y * img->stride[VPX_PLANE_Y], (size_t)w);
    uint8_t *uv = dst + (size_t)w * h;
    int cw = w / 2;
    for (int y = 0; y < h / 2; y++) {
        const uint8_t *u = img->planes[VPX_PLANE_U] + (size_t)y * img->stride[VPX_PLANE_U];
        const uint8_t *v = img->planes[VPX_PLANE_V] + (size_t)y * img->stride[VPX_PLANE_V];
        uint8_t *o = uv + (size_t)y * w;
        int x = 0;
        for (; x + 16 <= cw; x += 16) {
            __m128i a = _mm_loadu_si128((const __m128i *)(u + x)), b = _mm_loadu_si128((const __m128i *)(v + x));
            _mm_storeu_si128((__m128i *)(o + 2 * x), _mm_unpacklo_epi8(a, b));
            _mm_storeu_si128((__m128i *)(o + 2 * x + 16), _mm_unpackhi_epi8(a, b));
        }
        for (; x < cw; x++) {
            o[2 * x] = u[x];
            o[2 * x + 1] = v[x];
        }
    }
}

static int free_out(const Movie *m) {
    for (int i = 0; i < OUT_BUFS; i++)
        if (!m->out_held[i]) return i;
    return -1;
}
static int free_outs(const Movie *m) {
    int n = 0;
    for (int i = 0; i < OUT_BUFS; i++) n += !m->out_held[i];
    return n;
}
static int can_take(const Movie *m, const Pending *p) {
    int want = (p->size > 0) + ((p->flags & MOVIE_FLAG_EOS) && !m->eos_in);
    return free_outs(m) >= want;
}
static void push_decoded(Movie *m, int slot, unsigned flags, int64_t time, int bytes) {
    m->out_held[slot] = 1;
    m->out_bytes[slot] = bytes;
    m->decoded[m->ndecoded++] = (Ready){slot, flags, time};
}

// ---- Media Foundation H.264 (video/avc, Annex B) ----
// This title's movies are H.264 in Annex B byte-stream framing (00 00 00 01 start codes; each packet holds SEI, the
// SPS/PPS headers and slices), which the inbox software H.264 decoder MFT takes directly. The AAC track stays
// stubbed (raw LATM, which the AAC MFT does not parse). Output is NV12, copied row by row because the decoder's
// stride can exceed the width. Up to two trailing frames are lost: the MFT is not flushed at end of stream (its
// delayed frames would arrive after the game tears the movie down anyway).
static PlatMutex mf_init_mu = PLAT_MUTEX_INIT;
static int mf_started;
static void mf_startup(void) {
    // MFStartup once per process; CoInitializeEx on every thread that touches COM (the configuring guest thread
    // creates the MFT, the worker feeds it, so both initialise; a repeated call is a benign S_FALSE).
    plat_mutex_lock(&mf_init_mu);
    if (!mf_started) {
        HRESULT hr = MFStartup(MF_VERSION, MFSTARTUP_FULL);
        if (FAILED(hr)) rt_fatal("movie: MFStartup: %#lx", (unsigned long)hr);
        mf_started = 1;
    }
    plat_mutex_unlock(&mf_init_mu);
    CoInitializeEx(NULL, COINIT_MULTITHREADED);
}static IMFMediaType *mf_make_in(int w, int h, const uint8_t *seq, size_t seqlen) {
    IMFMediaType *t = NULL;
    if (FAILED(MFCreateMediaType(&t))) return NULL;
    HRESULT hr = t->lpVtbl->SetGUID(t, &MF_MT_MAJOR_TYPE, &MFMediaType_Video);
    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetGUID(t, &MF_MT_SUBTYPE, &MFVideoFormat_H264);
    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT64(t, &MF_MT_FRAME_SIZE, ((uint64_t)(uint32_t)w << 32) | (uint32_t)h);
    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT32(t, &MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);
    // The sequence header is prepended to the first sample instead of being carried on the type: with the
    // blob set, this decoder accepts every packet and emits nothing.
    (void)seq;
    (void)seqlen;
    if (FAILED(hr)) { t->lpVtbl->Release(t); return NULL; }
    return t;
}
static IMFMediaType *mf_make_out(int w, int h) {
    IMFMediaType *t = NULL;
    if (FAILED(MFCreateMediaType(&t))) return NULL;
    HRESULT hr = t->lpVtbl->SetGUID(t, &MF_MT_MAJOR_TYPE, &MFMediaType_Video);
    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetGUID(t, &MF_MT_SUBTYPE, &MFVideoFormat_NV12);
    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT64(t, &MF_MT_FRAME_SIZE, ((uint64_t)(uint32_t)w << 32) | (uint32_t)h);
    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT32(t, &MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);
    if (FAILED(hr)) { t->lpVtbl->Release(t); return NULL; }
    return t;
}static void mf_collect_seq(Movie *m, const uint8_t *d, size_t n) {
    // Annex B walk: stash the first SPS (type 7) and PPS (type 8), each with a 4-byte start code, for the MFT's
    // sequence header. A packet holds only a handful of NALs; beyond 64 start codes the rest is ignored.
    size_t offs[64];
    int nn = 0;
    for (size_t i = 0; i + 2 < n && nn < 64; i++)
        if (!d[i] && !d[i + 1] && d[i + 2] == 1) { offs[nn++] = i; i += 2; }
    for (int k = 0; k < nn; k++) {
        size_t hs = offs[k] + 3;
        if (hs >= n) continue;
        size_t ne = k + 1 < nn ? offs[k + 1] : n;
        while (ne > hs + 1 && !d[ne - 1]) ne--;
        int type = d[hs] & 0x1f;
        if (type != 7 && type != 8) continue;
        if ((type == 7 && m->mf_have_sps) || (type == 8 && m->mf_have_pps)) continue;
        size_t len = ne - hs;
        if (!len || len > 256) continue;
        if (m->mf_seq_len + 4 + len > m->mf_seq_cap) {
            size_t cap = m->mf_seq_cap ? m->mf_seq_cap * 2 : 512;
            while (cap < m->mf_seq_len + 4 + len) cap *= 2;
            if (cap > 65536) return;
            uint8_t *nb = realloc(m->mf_seq, cap);
            if (!nb) return;
            m->mf_seq = nb;
            m->mf_seq_cap = cap;
        }
        m->mf_seq[m->mf_seq_len++] = 0;
        m->mf_seq[m->mf_seq_len++] = 0;
        m->mf_seq[m->mf_seq_len++] = 0;
        m->mf_seq[m->mf_seq_len++] = 1;
        memcpy(m->mf_seq + m->mf_seq_len, d + hs, len);
        m->mf_seq_len += len;
        if (type == 7) m->mf_have_sps = 1;
        else m->mf_have_pps = 1;
    }
}static int mf_set_output(Movie *m) {
    // The decoder fixes its own output geometry (a 1080-line stream comes back as 1920x1088 and is cropped on
    // display), so the configured size is only a preference. Take the first NV12 type it offers and remember the
    // size it chose, because the copy-out below needs the coded height, not the visible one.
    for (DWORD i = 0; i < 32; i++) {
        IMFMediaType *t = NULL;
        if (FAILED(m->mf->lpVtbl->GetOutputAvailableType(m->mf, 0, i, &t)) || !t) break;
        GUID sub;
        UINT64 fs = 0;
        int nv12 = SUCCEEDED(t->lpVtbl->GetGUID(t, &MF_MT_SUBTYPE, &sub)) && !memcmp(&sub, &MFVideoFormat_NV12, sizeof sub);
        if (nv12 && SUCCEEDED(t->lpVtbl->GetUINT64(t, &MF_MT_FRAME_SIZE, &fs))) {
            int w = (int)(fs >> 32), h = (int)(fs & 0xffffffff);
            if (SUCCEEDED(m->mf->lpVtbl->SetOutputType(m->mf, 0, t, 0))) {
                m->mf_out_w = w;
                m->mf_out_h = h;
                t->lpVtbl->Release(t);
                if (w != m->w || h != m->h) rt_log("movie: H.264 output %dx%d for a %dx%d stream", w, h, m->w, m->h);
                return 1;
            }
        }
        t->lpVtbl->Release(t);
    }
    // No enumerable NV12: fall back to the sizes this decoder family accepts, then to the announced frame size.
    IMFMediaType *out = mf_make_out(m->w, m->h);
    if (out) {
        if (SUCCEEDED(m->mf->lpVtbl->SetOutputType(m->mf, 0, out, 0))) {
            out->lpVtbl->Release(out);
            m->mf_out_w = m->w;
            m->mf_out_h = m->h;
            return 1;
        }
        out->lpVtbl->Release(out);
    }
    return 0;
}

static void mf_configure_mft(Movie *m) {
    int seq = m->mf_have_sps && m->mf_have_pps;
    IMFMediaType *in = mf_make_in(m->w, m->h, seq ? m->mf_seq : NULL, seq ? m->mf_seq_len : 0);
    HRESULT hr_in = in ? m->mf->lpVtbl->SetInputType(m->mf, 0, in, 0) : E_OUTOFMEMORY;
    if (in) in->lpVtbl->Release(in);
    int ok_out = SUCCEEDED(hr_in) && mf_set_output(m);
    if (SUCCEEDED(hr_in) && ok_out) {
        m->mf->lpVtbl->ProcessMessage(m->mf, MFT_MESSAGE_NOTIFY_BEGIN_STREAMING, 0);
        // Without START_OF_STREAM this decoder accepts every sample and emits nothing at all.
        m->mf->lpVtbl->ProcessMessage(m->mf, MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0);
        m->mf_ready = 1;
        rt_log("movie: H.264 MFT decoding %dx%d (%s SPS/PPS sequence header)", m->w, m->h, seq ? "with" : "without");
    } else {
        m->mf_broken = 1;
        rt_log("movie: H.264 MFT setup: input %#lx output %s", (unsigned long)hr_in, ok_out ? "ok" : "failed");
    }
}
static int mf_open(Movie *m) {
    mf_startup();
    HRESULT hr = CoCreateInstance(&MF_CLSID_H264_DECODER, NULL, CLSCTX_INPROC_SERVER, &IID_IMFTransform,
                                  (void **)&m->mf);
    if (FAILED(hr) || !m->mf) {
        rt_log("movie: H.264 MFT creation: %#lx", (unsigned long)hr);
        return 0;
    }
    m->mf_live = 1;
    return 1;
}
static void mf_close(Movie *m) {
    if (m->mf) {
        m->mf->lpVtbl->ProcessMessage(m->mf, MFT_MESSAGE_COMMAND_FLUSH, 0);
        m->mf->lpVtbl->Release(m->mf);
        m->mf = NULL;
    }
    free(m->mf_seq);
    m->mf_seq = NULL;
    m->mf_seq_len = m->mf_seq_cap = 0;
    m->mf_live = m->mf_ready = m->mf_broken = m->mf_have_sps = m->mf_have_pps = 0;
    m->mf_pre = m->mf_thread_init = m->mf_warned = 0;
    m->mf_out_w = m->mf_out_h = m->mf_fed_first = 0;
}static HRESULT mf_in(Movie *m, const uint8_t *d, size_t n, int64_t time_us) {
    // Samples carry slices only, so the decoder gets the sequence header once, in band, ahead of the first sample.
    // MF_MT_MPEG_SEQUENCE_HEADER on the input type is NOT equivalent: with it this decoder consumes every packet and
    // emits no frame at all, while the same NALs in band decode immediately.
    size_t pre = !m->mf_fed_first ? m->mf_seq_len : 0;
    IMFMediaBuffer *buf = NULL;
    IMFSample *s = NULL;
    HRESULT hr = MFCreateMemoryBuffer((DWORD)(n + pre), &buf);
    if (SUCCEEDED(hr)) {
        BYTE *p = NULL;
        hr = buf->lpVtbl->Lock(buf, &p, NULL, NULL);
        if (SUCCEEDED(hr)) {
            if (pre) memcpy(p, m->mf_seq, pre);
            memcpy(p + pre, d, n);
            hr = buf->lpVtbl->Unlock(buf);
        }
    }
    if (SUCCEEDED(hr)) hr = buf->lpVtbl->SetCurrentLength(buf, (DWORD)(n + pre));
    if (SUCCEEDED(hr)) hr = MFCreateSample(&s);
    if (SUCCEEDED(hr)) hr = s->lpVtbl->AddBuffer(s, buf);
    if (SUCCEEDED(hr) && time_us > 0) hr = s->lpVtbl->SetSampleTime(s, time_us * 10);   // 100 ns units
    if (SUCCEEDED(hr)) hr = m->mf->lpVtbl->ProcessInput(m->mf, 0, s, 0);
    if (SUCCEEDED(hr)) m->mf_fed_first = 1;
    if (s) s->lpVtbl->Release(s);
    if (buf) buf->lpVtbl->Release(buf);
    return hr;
}

static HRESULT mf_out(Movie *m, uint8_t *dst, int w, int h, int *got) {
    *got = 0;
    MFT_OUTPUT_STREAM_INFO oi;
    memset(&oi, 0, sizeof oi);
    if (FAILED(m->mf->lpVtbl->GetOutputStreamInfo(m->mf, 0, &oi))) return E_FAIL;
    for (int k = 0; k < 4; k++) {
        MFT_OUTPUT_DATA_BUFFER ob;
        DWORD st = 0;
        IMFSample *own = NULL;
        IMFMediaBuffer *ownb = NULL;
        memset(&ob, 0, sizeof ob);
        // This decoder allocates nothing for the caller, and ProcessOutput answers E_INVALIDARG when pSample is
        // NULL, so a sample has to be handed in whenever the stream info does not promise one.
        if (!(oi.dwFlags & MFT_OUTPUT_STREAM_PROVIDES_SAMPLES)) {
            DWORD cap = oi.cbSize ? oi.cbSize : (DWORD)((size_t)m->w * m->h * 3 / 2 + 8192);
            if (SUCCEEDED(MFCreateSample(&own)) && SUCCEEDED(MFCreateMemoryBuffer(cap, &ownb)) &&
                SUCCEEDED(own->lpVtbl->AddBuffer(own, ownb)))
                ob.pSample = own;
        }
        HRESULT hr = m->mf->lpVtbl->ProcessOutput(m->mf, 0, 1, &ob, &st);
        if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT) {
            if (own) own->lpVtbl->Release(own);
            if (ownb) ownb->lpVtbl->Release(ownb);
            return S_OK;
        }
        if (hr == MF_E_TRANSFORM_STREAM_CHANGE) {
            if (own) own->lpVtbl->Release(own);
            if (ownb) ownb->lpVtbl->Release(ownb);
            if (ob.pSample) ob.pSample->lpVtbl->Release(ob.pSample);
            if (ob.pEvents) ob.pEvents->lpVtbl->Release(ob.pEvents);
            if (!mf_set_output(m)) return E_FAIL;
            continue;
        }
        if (FAILED(hr) || !ob.pSample) {
            if (own) own->lpVtbl->Release(own);
            if (ownb) ownb->lpVtbl->Release(ownb);
            if (ob.pSample) ob.pSample->lpVtbl->Release(ob.pSample);
            if (ob.pEvents) ob.pEvents->lpVtbl->Release(ob.pEvents);
            return FAILED(hr) ? hr : S_OK;
        }
        int sw = m->mf_out_w > 0 ? m->mf_out_w : w;
        int sh = m->mf_out_h > 0 ? m->mf_out_h : h;
        IMFMediaBuffer *cb = NULL;
        if (SUCCEEDED(ob.pSample->lpVtbl->ConvertToContiguousBuffer(ob.pSample, &cb))) {
            IMF2DBuffer *b2 = NULL;
            if (SUCCEEDED(cb->lpVtbl->QueryInterface(cb, &IID_IMF2DBuffer, (void **)&b2))) {
                BYTE *p = NULL;
                LONG pitch = 0;
                HRESULT lhr = b2->lpVtbl->Lock2D(b2, &p, &pitch);
                if (SUCCEEDED(lhr) && p && pitch >= sw) {
                    if (!*got) {
                        int cw = sw < w ? sw : w;
                        for (int y = 0; y < h; y++) memcpy(dst + (size_t)y * w, p + (size_t)y * pitch, (size_t)cw);
                        uint8_t *uv = dst + (size_t)w * h;
                        const uint8_t *sp = p + (size_t)pitch * sh;
                        int ch = h / 2 < sh / 2 ? h / 2 : sh / 2;
                        for (int y = 0; y < ch; y++) memcpy(uv + (size_t)y * w, sp + (size_t)y * pitch, (size_t)cw);
                    }
                    (*got)++;
                }
                if (SUCCEEDED(lhr)) b2->lpVtbl->Unlock2D(b2);
                b2->lpVtbl->Release(b2);
            } else {
                // The samples this decoder writes are plain memory buffers, so the 2-D path is only a shortcut; the
                // contiguous buffer is NV12 of the coded size with no padding between the planes.
                BYTE *p = NULL;
                DWORD len = 0;
                if (SUCCEEDED(cb->lpVtbl->Lock(cb, &p, NULL, &len))) {
                    int sw = m->mf_out_w > 0 ? m->mf_out_w : w;
                    int sh = m->mf_out_h > 0 ? m->mf_out_h : h;
                    if (p && len >= (DWORD)((size_t)sw * sh * 3 / 2)) {
                        if (!*got) {
                            int cw = sw < w ? sw : w;
                            for (int y = 0; y < h; y++) memcpy(dst + (size_t)y * w, p + (size_t)y * sw, (size_t)cw);
                            uint8_t *uv = dst + (size_t)w * h;
                            const uint8_t *sp = p + (size_t)sw * sh;
                            int ch = h / 2 < sh / 2 ? h / 2 : sh / 2;
                            for (int y = 0; y < ch; y++) memcpy(uv + (size_t)y * w, sp + (size_t)y * sw, (size_t)cw);
                        }
                        (*got)++;
                    } else if (!m->mf_warned) {
                        m->mf_warned = 1;
                        rt_log("movie: H.264 output layout %lu bytes for %dx%d; frames dropped", (unsigned long)len, sw, sh);
                    }
                    cb->lpVtbl->Unlock(cb);
                }
            }
            cb->lpVtbl->Release(cb);
        }
        if (ob.pSample != own && ob.pSample) ob.pSample->lpVtbl->Release(ob.pSample);
        if (own) own->lpVtbl->Release(own);
        if (ownb) ownb->lpVtbl->Release(ownb);
        if (ob.pEvents) ob.pEvents->lpVtbl->Release(ob.pEvents);
    }
    return S_OK;
}
// The avcC record of the movie the game has open. Configure's MediaData is not readable from the host (its concrete
// type is not NnMediaData here), and this title's samples carry SEI and IDR slices only, so the SPS/PPS come from the
// container: the fs layer reports every .mp4 it opens, and the first of those with a readable avcC seeds the next AVC
// decoder. The three movies do not share one record (FOAF1/2 are Main, FOAF3 is High), so the path matters.
static int mf_avcc_to_annexb(const uint8_t *d, size_t n, uint8_t *out, size_t cap, size_t *olen) {
    *olen = 0;
    if (n < 8 || d[0] != 1) return 0;
    int num = d[5] & 31, sps = 0, pps = 0;
    size_t o = 0, i = 6;
    for (int k = 0; k < num && i + 2 <= n; k++) {
        size_t len = ((size_t)d[i] << 8) | d[i + 1];
        i += 2;
        if (i + len > n || len < 2 || o + 4 + len > cap) return 0;
        out[o++] = 0; out[o++] = 0; out[o++] = 0; out[o++] = 1;
        memcpy(out + o, d + i, len);
        o += len; i += len; sps = 1;
    }
    if (i >= n) return 0;
    int np = d[i++];
    for (int k = 0; k < np && i + 2 <= n; k++) {
        size_t len = ((size_t)d[i] << 8) | d[i + 1];
        i += 2;
        if (i + len > n || len < 1 || o + 4 + len > cap) return 0;
        out[o++] = 0; out[o++] = 0; out[o++] = 0; out[o++] = 1;
        memcpy(out + o, d + i, len);
        o += len; i += len; pps = 1;
    }
    if (!sps || !pps || !o) return 0;
    *olen = o;
    return 1;
}

static PlatMutex hint_mu = PLAT_MUTEX_INIT;
static uint8_t hint_seq[1024];
static size_t hint_len;

// The fs layer hands over the head of every .mp4 it opens. The container's avcC is the only place this title's SPS and
// PPS appear (its samples carry SEI and IDR slices only), and Configure's own MediaData is not readable from the host:
// its concrete type here is not NnMediaData, so the accessors for csd-0 do not apply to it.
int movie_note_media_bytes(const void *buf, size_t n) {
    const uint8_t *d = buf;
    if (!d || n < 8) return 0;
    for (size_t i = 4; i + 4 < n; i++) {
        if (memcmp(d + i, "avcC", 4)) continue;
        size_t box = ((size_t)d[i - 4] << 24) | ((size_t)d[i - 3] << 16) | ((size_t)d[i - 2] << 8) | d[i - 1];
        if (box < 8 || i - 4 + box > n) return 0;
        uint8_t annexb[1024];
        size_t olen = 0;
        if (!mf_avcc_to_annexb(d + i + 4, box - 8, annexb, sizeof annexb, &olen)) return 0;
        plat_mutex_lock(&hint_mu);
        memcpy(hint_seq, annexb, olen);
        hint_len = olen;
        plat_mutex_unlock(&hint_mu);
        rt_log("movie: the open movie's avcC gives %d bytes of SPS/PPS", (int)olen);
        return 1;
    }
    return 0;
}

static int mf_hint_avc(Movie *m) {
    plat_mutex_lock(&hint_mu);
    size_t n = hint_len;
    uint8_t *seq = n ? malloc(n) : NULL;
    if (seq) memcpy(seq, hint_seq, n);
    plat_mutex_unlock(&hint_mu);
    if (!seq) return 0;
    free(m->mf_seq);
    m->mf_seq = seq;
    m->mf_seq_len = m->mf_seq_cap = n;
    m->mf_have_sps = m->mf_have_pps = 1;
    return 1;
}

static int vpx_open(Movie *m) {
    vpx_codec_dec_cfg_t cfg = {.threads = VPX_THREADS, .w = (unsigned)m->w, .h = (unsigned)m->h};
    if (vpx_codec_dec_init(&m->vpx, vpx_codec_vp9_dx(), &cfg, 0) != VPX_CODEC_OK) return 0;
    vpx_codec_control(&m->vpx, VP9D_SET_ROW_MT, 1);
    m->vpx_live = 1;
    return 1;
}

// The worker: takes inputs in order, decodes them outside the lock into a reserved output slot, publishes the frame.
static void worker(void *arg) {
    Movie *m = arg;
    plat_mutex_lock(&m->mu);
    for (;;) {
        while (!m->quit && !(m->started && (m->vpx_live || m->mf_live) && m->npending && can_take(m, &m->pending[0])))
            plat_cond_wait(&m->work, &m->mu);
        if (m->quit) break;
        Pending p = m->pending[0];
        memmove(m->pending, m->pending + 1, (size_t)--m->npending * sizeof *m->pending);
        int slot = -1;
        if (p.size > 0) {
            slot = free_out(m);
            m->out_held[slot] = 1;   // reserved: in no queue, so the game cannot release it
        }
        uint64_t gen = m->gen, dt = 0;
        int got = 0, w = m->w, h = m->h;
        uint8_t *dst = slot >= 0 ? m->out[slot] : NULL;
        vpx_codec_err_t e = VPX_CODEC_OK;
        const char *bad = NULL;
        int failed = 0;
        HRESULT mf_hr = S_OK;
        const char *mf_stage = NULL;
        m->busy = 1;
        plat_mutex_unlock(&m->mu);
        if (p.size > 0) {
            uint64_t t0 = kern_now_ns();
            if (m->mf_is_avc) {
                if (!m->mf_thread_init) { mf_startup(); m->mf_thread_init = 1; }
                {
                const uint8_t *data = m->in[p.index] + p.offset;
                size_t size = (size_t)p.size;
                if (!m->mf_ready && !m->mf_broken) {
                    mf_collect_seq(m, data, size);
                    m->mf_pre++;
                    if ((m->mf_have_sps && m->mf_have_pps) || m->mf_pre >= 64) mf_configure_mft(m);
                }
                if (m->mf_broken) failed = 1;
                else if (m->mf_ready) {
                    mf_stage = "in";
                    mf_hr = mf_in(m, data, size, p.time);
                    if (SUCCEEDED(mf_hr)) { mf_stage = "out"; mf_hr = mf_out(m, dst, w, h, &got); }
                    failed = FAILED(mf_hr);
                }
                }
            } else {
            e = vpx_codec_decode(&m->vpx, m->in[p.index] + p.offset, (unsigned)p.size, NULL, 0);
            if (e == VPX_CODEC_OK) {
                vpx_codec_iter_t it = NULL;
                const vpx_image_t *img;
                while ((img = vpx_codec_get_frame(&m->vpx, &it)) != NULL) {
                    if (img->fmt != VPX_IMG_FMT_I420 || (int)img->d_w != w || (int)img->d_h != h) bad = "layout";
                    else if (!got) to_nv12(img, dst, w, h);
                    got++;
                }
            }
                failed = e != VPX_CODEC_OK;
            }
            dt = kern_now_ns() - t0;
        }
        plat_mutex_lock(&m->mu);
        m->busy = 0;
        plat_cond_broadcast(&m->idle);
        if (m->gen != gen) continue;   // flushed, stopped or reset meanwhile: the queues were reset after this
        m->in_free[m->nin_free++] = p.index;
        m->owed |= 1u << MOVIE_EV_INPUT;
        if (p.size > 0) {
            m->st.decode_ns += dt;
            if (dt > m->st.max_ns) m->st.max_ns = dt;
            if (bad) rt_fatal("movie: VP9 frame layout differs from the configured %dx%d I420", w, h);
            if (failed || !got) {
                m->out_held[slot] = 0;
                if (failed) {
                    m->st.errors++;
                    m->last_error = ST_ERROR;
                    m->owed |= 1u << MOVIE_EV_ERROR;
                    if (m->st.errors <= 4) {
                        if (m->mf_is_avc)
                            rt_log("movie: H.264 decode error (%s) on a %d-byte frame at %lld us: hr=%#lx", mf_stage,
                                   p.size, (long long)p.time, (unsigned long)mf_hr);
                        else {
                        const char *d = vpx_codec_error_detail(&m->vpx);
                        rt_log("movie: VP9 decode error on a %d-byte frame at %lld us: %s", p.size, (long long)p.time,
                               d ? d : vpx_codec_err_to_string(e));
                            }
                    }
                }
            } else {
                if (got > 1) rt_log("movie: %d frames from one input at %lld us, the first kept", got, (long long)p.time);
                if (!m->format_sent) {
                    m->format_sent = 1;
                    m->owed |= 1u << MOVIE_EV_FORMAT;
                }
                push_decoded(m, slot, 0, p.time, frame_bytes(m));
                m->st.frames++;
                if (m->st.frames % 600 == 0)
                    rt_log("movie: %llu frames, decode %.2f ms per frame (max %.2f)", (unsigned long long)m->st.frames,
                           m->st.decode_ns / 1e6 / (double)m->st.frames, m->st.max_ns / 1e6);
            }
        }
        if (p.flags & MOVIE_FLAG_EOS && !m->eos_in) {
            m->eos_in = 1;
            push_decoded(m, free_out(m), MOVIE_FLAG_EOS, p.time, 0);
            rt_log("movie: end of stream after %llu frames from %llu inputs (decode %.2f ms per frame, max %.2f, %llu errors)",
                   (unsigned long long)m->st.frames, m->fed_in, m->st.frames ? m->st.decode_ns / 1e6 / (double)m->st.frames : 0.0,
                   m->st.max_ns / 1e6, (unsigned long long)m->st.errors);
        }
    }
    plat_mutex_unlock(&m->mu);
    return;
}

// With m->mu held: invalidate a decode in flight and wait for the worker to leave it. Returns whether the calling guest
// thread gave its core up; the caller calls kern_core_back after releasing m->mu.
static int quiesce(Movie *m) {
    int away = 0;
    m->gen++;
    while (m->busy) {
        if (!away) away = kern_core_away();
        plat_cond_wait(&m->idle, &m->mu);
    }
    return away;
}
static void unlock_back(Movie *m, int away) {
    plat_mutex_unlock(&m->mu);
    kern_core_back(&away);
}

static void reset_queues(Movie *m) {
    m->nin_free = 0;
    for (int i = 0; i < IN_BUFS; i++) m->in_free[m->nin_free++] = i;
    memset(m->out_held, 0, sizeof m->out_held);
    m->npending = m->nready = m->ndecoded = 0;
    m->eos_in = 0;
    m->t0 = 0;
}
static void release_codec(Movie *m) {   // m->mu held, worker quiesced
    if (m->vpx_live) {
        vpx_codec_destroy(&m->vpx);
        m->vpx_live = 0;
    }
    mf_close(m);
    for (int i = 0; i < IN_BUFS; i++) {
        if (m->in[i]) mem_kernel_free(m->in[i], IN_CAP);
        m->in[i] = NULL;
    }
    for (int i = 0; i < OUT_BUFS; i++) {
        free(m->out[i]);
        m->out[i] = NULL;
    }
    m->configured = m->started = 0;
    reset_queues(m);
}

// Host time a decoded frame is due (ns); end of stream is due as soon as it is first in line.
static uint64_t due_at(const Movie *m, const Ready *d) {
    int64_t ahead = d->time - m->pts0;
    if (ahead < 0) ahead = 0;
    return m->t0 + (uint64_t)ahead * 1000;
}
// One present: drop leading frames more than 1.5 periods late while the next one is due too, then hand over at most one
// due frame (end of stream right after the last frame).
static void release_due(Movie *m, uint64_t now) {
    if (!m->ndecoded) return;
    if (!pace_on()) {
        for (int i = 0; i < m->ndecoded; i++) m->ready[m->nready++] = m->decoded[i];
        m->st.handed += m->ndecoded;
        m->ndecoded = 0;
        m->owed |= 1u << MOVIE_EV_OUTPUT;
        return;
    }
    while (m->ndecoded > 1 && m->t0 && !(m->decoded[0].flags & MOVIE_FLAG_EOS) &&
           !(m->decoded[1].flags & MOVIE_FLAG_EOS)) {
        uint64_t due = due_at(m, &m->decoded[0]), next = due_at(m, &m->decoded[1]);
        if (now < next || now - due <= (next - due) * 3 / 2) break;
        m->out_held[m->decoded[0].index] = 0;
        m->st.dropped++;
        memmove(m->decoded, m->decoded + 1, (size_t)--m->ndecoded * sizeof *m->decoded);
        plat_cond_signal(&m->work);
    }
    Ready d = m->decoded[0];
    if (!(d.flags & MOVIE_FLAG_EOS)) {
        if (!m->t0) {
            m->t0 = now;
            m->pts0 = d.time;
        }
        if (now < due_at(m, &d)) return;
    }
    memmove(m->decoded, m->decoded + 1, (size_t)--m->ndecoded * sizeof *m->decoded);
    m->ready[m->nready++] = d;
    m->st.handed++;
    m->owed |= 1u << MOVIE_EV_OUTPUT;
    if (d.flags & MOVIE_FLAG_EOS)
        rt_log("movie: EOS handed to ready (handed=%llu)", (unsigned long long)m->st.handed);
}

void movie_tick(Cpu *c) {
    if (!g_count) return;
    {   // temporary EOS-hang diagnosis: is the present pump still alive?
        static int ntick = 0;
        if ((++ntick % 1800) == 0) {
            int nd = 0, nr = 0;
            for (int i = 0; i < MAX_MOVIES; i++) {
                Movie *mm = g_movies[i];
                if (mm) { nd += mm->ndecoded; nr += mm->nready; }
            }
            rt_log("movie: tick alive (%d ticks, queued decoded=%d ready=%d)", ntick, nd, nr);
        }
    }
    Signals s = {0};
    plat_mutex_lock_shared(&g_lock);
    for (int i = 0; i < MAX_MOVIES; i++) {
        Movie *m = g_movies[i];
        if (!m) continue;
        plat_mutex_lock(&m->mu);
        if (m->started) release_due(m, g_clock());
        collect(m, &s);
        plat_mutex_unlock(&m->mu);
    }
    plat_mutex_unlock_shared(&g_lock);
    fire(c, &s);
}

// A host decoder is live: a movie plays (frame_rate.c caps the frame rate to 30 while it does).
int movie_playing(void) { return plat_cas32(&g_count, 0, 0) > 0; }

int movie_stats(uint64_t obj, MovieStats *out) {
    Movie *m = find(obj);
    if (!m) return 0;
    plat_mutex_lock_shared(&m->mu);
    *out = m->st;
    plat_mutex_unlock_shared(&m->mu);
    return 1;
}

int movie_quiet(uint64_t obj) {
    Movie *m = find(obj);
    if (!m) return 1;
    plat_mutex_lock_shared(&m->mu);
    int q = !m->busy && !(m->started && (m->vpx_live || m->mf_live) && m->npending && can_take(m, &m->pending[0]));
    plat_mutex_unlock_shared(&m->mu);
    return q;
}

// ---- entries
// Decoder(DecoderType type, DecoderOutputFormat format): XC2's SDK 3.5 movie library has no DecoderMode or priority
// argument (XCX's 1.2.1/1.4.3 one does); its decoders are always buffer mode (DecoderImpl's constructor without the
// native-window flag).
static void ov_ctor(Cpu *c) {
    uint64_t obj = arg_x(c, 0);
    int type = (int)arg_x(c, 1), format = (int)arg_x(c, 2);
    guest_init();
    int host = type == MOVIE_TYPE_VP9 || type == MOVIE_TYPE_AVC;
    int stub = !host && stub_on();
    if ((!host && !stub) || host_off()) {
        rt_log("movie: decoder type %d format %d left to the library%s", type, format,
               host_off() ? " (XC2_MOVIE_HOST=0)" : " (only VP9 runs on the host)");
        pass(c, MOVIE_CTOR);
        return;
    }
    Movie *m = calloc(1, sizeof *m);
    if (!m) rt_fatal("movie: decoder allocation");
    m->guest = obj;
    m->format = format;
    plat_mutex_init(&m->mu);
    plat_cond_init(&m->work);
    plat_cond_init(&m->idle);
    m->stub = stub;
    m->mf_is_avc = !stub && type == MOVIE_TYPE_AVC;
    if (!stub && !(m->thread = plat_thread_new(worker, m, "movie"))) rt_fatal("movie: cannot start the worker thread");
    plat_mutex_lock(&g_lock);
    int i = 0;
    while (i < MAX_MOVIES && g_movies[i] && g_movies[i]->guest != obj) i++;
    if (i == MAX_MOVIES) rt_fatal("movie: more than %d live decoders", MAX_MOVIES);
    if (g_movies[i]) rt_fatal("movie: decoder object %#llx constructed twice", (unsigned long long)obj);
    g_movies[i] = m;
    plat_inc32(&g_count);
    plat_mutex_unlock(&g_lock);
    ST64(obj, G.vptr);
    ST64(obj + 8, U(m));
    rt_log("movie: %s decoder %#llx on the host (%s), type %d output format %d", stub ? "stub" : type == MOVIE_TYPE_AVC ? "AVC" : "VP9",
           (unsigned long long)obj, stub ? "skipped, no decoding" : type == MOVIE_TYPE_AVC ? "Media Foundation" : vpx_codec_version_str(), type, format);
}

static void destroy(Cpu *c, uint64_t obj) {
    (void)c;
    Movie *m = NULL;
    plat_mutex_lock(&g_lock);
    for (int i = 0; i < MAX_MOVIES; i++)
        if (g_movies[i] && g_movies[i]->guest == obj) {
            m = g_movies[i];
            g_movies[i] = NULL;
            plat_dec32(&g_count);
        }
    plat_mutex_unlock(&g_lock);
    if (!m) return;
    plat_mutex_lock(&m->mu);
    m->quit = 1;
    m->gen++;
    plat_cond_broadcast(&m->work);
    plat_mutex_unlock(&m->mu);
    int away = kern_core_away();
    if (m->thread) plat_thread_join(m->thread);
    kern_core_back(&away);
    rt_log("movie: decoder %#llx destroyed after %llu frames (%llu dropped to keep time)", (unsigned long long)obj,
           (unsigned long long)m->st.frames, (unsigned long long)m->st.dropped);
    release_codec(m);
    free(m);
    ST64(obj, G.vptr);   // what the library's destructor leaves (no DecoderImpl)
    ST64(obj + 8, 0);
}

static void ov_d2(Cpu *c) {
    uint64_t obj = arg_x(c, 0);
    rt_log("movie: D2 obj=%llx", (unsigned long long)obj);
    if (!find(obj)) { pass(c, MOVIE_D2); return; }
    destroy(c, obj);
}
// Deleting destructor: free the host state, then the library's deleting destructor frees the object (impl now 0).
static void ov_d0(Cpu *c) {
    uint64_t obj = arg_x(c, 0);
    rt_log("movie: D0 obj=%llx", (unsigned long long)obj);
    if (find(obj)) destroy(c, obj);
    pass(c, MOVIE_D0);
}

// Status Configure(MediaData *format)
static void ov_configure(Cpu *c) {
    uint64_t obj = arg_x(c, 0), md = arg_x(c, 1);
    Movie *m = find(obj);
    if (!m) { pass(c, MOVIE_CONFIGURE); return; }
    if (!md) { ret_x(c, ST_NULL); return; }
    if (m->stub) {
        uint64_t mp = 0;
        int w = 0, h = 0;
        rt_call(c, G.md_find_string, 3, md, U("mime"), U(&mp));
        md_find_int32(c, md, "width", &w);
        md_find_int32(c, md, "height", &h);
        const char *mime = (const char *)(uintptr_t)mp;
        plat_mutex_lock(&m->mu);
        int away = quiesce(m);
        release_codec(m);
        m->w = w > 0 ? w : 2;   // a size the buffer arithmetic accepts; no frame is ever handed over
        m->h = h > 0 ? h : 2;
        for (int i = 0; i < IN_BUFS; i++) m->in[i] = mem_kernel_alloc(IN_CAP, 0x1000);
        for (int i = 0; i < OUT_BUFS; i++)
            if (!(m->out[i] = malloc(16))) rt_fatal("movie: output buffers");
        reset_queues(m);
        m->format_sent = 1;
        m->configured = 1;
        m->last_error = 0;
        m->stub_fed = 0;
        unlock_back(m, away);
        rt_log("movie: stub decoder configured (mime %s %dx%d): the input is consumed, end of stream is reported at once",
               mime ? mime : "(none)", w, h);
        ret_x(c, ST_OK);
        return;
    }
    // Format 4 is this title NV12: the same packed layout.
    if (m->format != MOVIE_FORMAT_NV12 && m->format != 4) {
        rt_log("movie: output format %d not implemented on the host (NV12 = %d or 4)", m->format, MOVIE_FORMAT_NV12);
        ret_x(c, ST_UNSUPPORTED);
        return;
    }
    uint64_t mime_p = 0;
    int w = 0, h = 0;
    rt_call(c, G.md_find_string, 3, md, U("mime"), U(&mime_p));
    md_find_int32(c, md, "width", &w);
    md_find_int32(c, md, "height", &h);
    const char *mime = (const char *)(uintptr_t)mime_p;
    if ((!mime || (strcmp(mime, "video/x-vnd.on2.vp9") && mime && strcmp(mime, "video/avc"))) || w <= 0 || h <= 0 || w > 8192 || h > 8192 || (w | h) & 1) {
        rt_log("movie: configure: mime %s %dx%d not supported", mime ? mime : "(none)", w, h);
        ret_x(c, ST_UNSUPPORTED);
        return;
    }
    plat_mutex_lock(&m->mu);
    int away = quiesce(m);
    release_codec(m);
    m->w = w;
    m->h = h;
    m->mf_is_avc = mime && !strcmp(mime, "video/avc");
    if (m->mf_is_avc) {
        if (!mf_open(m)) rt_fatal("movie: H.264 MFT creation");
    } else if (!vpx_open(m)) rt_fatal("movie: libvpx VP9 decoder initialisation");
    if (m->mf_is_avc && !mf_hint_avc(m))
        rt_log("movie: no avcC seen for the open movie yet; the SPS/PPS are collected from the stream instead");
    for (int i = 0; i < IN_BUFS; i++) m->in[i] = mem_kernel_alloc(IN_CAP, 0x1000);
    for (int i = 0; i < OUT_BUFS; i++)
        if (!(m->out[i] = malloc((size_t)frame_bytes(m)))) rt_fatal("movie: output buffers");
    reset_queues(m);
    m->format_sent = 0;
    m->configured = 1;
    m->last_error = 0;
    unlock_back(m, away);
    rt_log("movie: configured %dx%d %s, %d input buffers of %d KiB, %d output frames of %d bytes", w, h, m->mf_is_avc ? "AVC (Media Foundation)" : "VP9", IN_BUFS,
           IN_CAP >> 10, OUT_BUFS, frame_bytes(m));
    ret_x(c, ST_OK);
}

// Status RegisterClientEvents(DecoderEvents *events)
static void ov_register_events(Cpu *c) {
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_REGISTER_EVENTS); return; }
    plat_mutex_lock(&m->mu);
    m->events = arg_x(c, 1);
    plat_mutex_unlock(&m->mu);
    ret_x(c, ST_OK);
}

static void set_format(Cpu *c, int w, int h, uint64_t md) {
    rt_call(c, G.md_set_string, 3, md, U("mime"), U("video/raw"));
    md_set_int32(c, md, "width", w);
    md_set_int32(c, md, "height", h);
    md_set_int32(c, md, "stride", w);
    md_set_int32(c, md, "slice-height", h);
    md_set_int32(c, md, "color-format", 21);   // COLOR_FormatYUV420SemiPlanar
    rt_call(c, G.md_set_rect, 6, md, U("crop"), (uint64_t)0, (uint64_t)0, (uint64_t)(uint32_t)(w - 1),
            (uint64_t)(uint32_t)(h - 1));
    md_set_int32(c, md, "crop-width", w);
    md_set_int32(c, md, "crop-height", h);
    md_set_int32(c, md, "nv12-y-stride", w);
    md_set_int32(c, md, "nv12-uv-stride", w);
    md_set_int32(c, md, "nv12-y-offset", 0);
    md_set_int32(c, md, "nv12-uv-offset", w * h);
}

// Status GetOutputFormat(MediaData *format)
static void ov_get_output_format(Cpu *c) {
    uint64_t md = arg_x(c, 1);
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_GET_OUTPUT_FORMAT); return; }
    if (!md) { ret_x(c, ST_NULL); return; }
    plat_mutex_lock_shared(&m->mu);
    int ok = m->configured, w = m->w, h = m->h;
    plat_mutex_unlock_shared(&m->mu);
    if (!ok) { ret_x(c, ST_ERROR); return; }
    set_format(c, w, h, md);
    ret_x(c, ST_OK);
}

static void ov_start(Cpu *c) {
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_START); return; }
    Signals s = {0};
    plat_mutex_lock(&m->mu);
    int st = ST_NOT_CONFIGURED;
    if (m->configured) {
        m->started = 1;
        m->owed |= 1u << MOVIE_EV_INPUT;
        plat_cond_signal(&m->work);
        st = ST_OK;
    }
    collect(m, &s);
    plat_mutex_unlock(&m->mu);
    fire(c, &s);
    ret_x(c, (uint32_t)st);
}

static void ov_stop(Cpu *c) {
    Movie *m = find(arg_x(c, 0));
    rt_log("movie: Stop");
    if (!m) { pass(c, MOVIE_STOP); return; }
    plat_mutex_lock(&m->mu);
    int away = quiesce(m);
    rt_log("movie: stop after %llu frames (%llu dropped to keep time; decode %.2f ms per frame, max %.2f)",
           (unsigned long long)m->st.frames, (unsigned long long)m->st.dropped,
           m->st.frames ? m->st.decode_ns / 1e6 / (double)m->st.frames : 0.0, m->st.max_ns / 1e6);
    release_codec(m);
    unlock_back(m, away);
    ret_x(c, ST_OK);
}

static void ov_reset(Cpu *c) {
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_RESET); return; }
    plat_mutex_lock(&m->mu);
    int away = quiesce(m);
    release_codec(m);
    m->last_error = 0;
    unlock_back(m, away);
    ret_x(c, ST_OK);
}

// Drop queued work; the next input starts a new decode (after a seek: a key frame).
static void ov_flush(Cpu *c) {
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_FLUSH); return; }
    plat_mutex_lock(&m->mu);
    int away = quiesce(m);
    if (m->configured) {
        vpx_codec_destroy(&m->vpx);
        m->vpx_live = 0;
        if (!vpx_open(m)) rt_fatal("movie: libvpx VP9 decoder re-initialisation");
        reset_queues(m);
    }
    unlock_back(m, away);
    ret_x(c, ST_OK);
}

// Status AcquireInputBufferIndex(int *index, int *remaining)
static void ov_acquire_input(Cpu *c) {
    int *index = arg_p(c, 1), *remaining = arg_p(c, 2);
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_ACQUIRE_INPUT); return; }
    if (!index || !remaining) { ret_x(c, ST_NULL); return; }
    Signals s = {0};
    plat_mutex_lock(&m->mu);
    *index = -1;
    *remaining = 0;
    int st = ST_NO_INPUT;
    if (m->started && m->nin_free > 0) {
        *index = m->in_free[0];
        memmove(m->in_free, m->in_free + 1, (size_t)--m->nin_free * sizeof *m->in_free);
        *remaining = m->nin_free;
        st = ST_OK;
    }
    collect(m, &s);
    plat_mutex_unlock(&m->mu);
    fire(c, &s);
    ret_x(c, (uint32_t)st);
}

// Status GetInputBuffer(int index, Buffer *buffer)
static void ov_get_input(Cpu *c) {
    int index = (int)arg_x(c, 1);
    uint64_t buf = arg_x(c, 2);
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_GET_INPUT); return; }
    if (!buf) { ret_x(c, ST_NULL); return; }
    plat_mutex_lock_shared(&m->mu);
    uint8_t *p = index >= 0 && index < IN_BUFS ? m->in[index] : NULL;
    plat_mutex_unlock_shared(&m->mu);
    buf_set_range(c, buf, 0, p ? IN_CAP : 0);
    buf_set_data(c, buf, U(p), p ? IN_CAP : 0);
    ret_x(c, p ? ST_OK : ST_ERROR);
}

// Status SendInputBufferForDecode(int index, int offset, int size, long time, unsigned flags)
static void ov_send_input(Cpu *c) {
    int index = (int)arg_x(c, 1), offset = (int)arg_x(c, 2), size = (int)arg_x(c, 3);
    int64_t time = (int64_t)arg_x(c, 4);
    unsigned flags = (unsigned)arg_x(c, 5);
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_SEND_INPUT); return; }
    if (index < 0 || index >= IN_BUFS || offset < 0 || size < 0 || (int64_t)offset + size > IN_CAP) {
        ret_x(c, ST_ERROR);
        return;
    }
    if (m->stub) {   // no worker: the buffer is free again at once
        Signals s = {0};
        plat_mutex_lock(&m->mu);
        {   // XC2_MOVIE_DUMP: log the first packets' heads (framing recon: Annex B vs avcC, ADTS vs LATM)
            static int dump_init = 0, dump_on = 0;
            if (!dump_init) { dump_on = cfg_get("XC2_MOVIE_DUMP") != NULL; dump_init = 1; }
            if (dump_on && m->stub_fed < 4 && size >= 8 && index >= 0 && index < IN_BUFS && m->in[index]) {
                const uint8_t *b = m->in[index] + offset;
                rt_log("movie: dump pkt%d size=%d time=%lld flags=%u: %02x %02x %02x %02x %02x %02x %02x %02x",
                       m->stub_fed, size, (long long)time, flags, b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
            }
        }
        int dup = 0;
        for (int i = 0; i < m->nin_free; i++) dup |= m->in_free[i] == index;
        if (!dup && m->nin_free < IN_BUFS) m->in_free[m->nin_free++] = index;
        m->owed |= 1u << MOVIE_EV_INPUT;
        // End of stream on the packet that carries it; on the fourth one regardless, so a player that never sends one ends.
        if (!m->eos_in && ((flags & MOVIE_FLAG_EOS) || ++m->stub_fed >= 4)) {
            m->eos_in = 1;
            m->ready[m->nready++] = (Ready){0, MOVIE_FLAG_EOS, time};
            m->owed |= 1u << MOVIE_EV_OUTPUT;
            rt_log("movie: stub decoder reached end of stream after %d input packets", m->stub_fed);
        }
        collect(m, &s);
        plat_mutex_unlock(&m->mu);
        fire(c, &s);
        ret_x(c, ST_OK);
        return;
    }
    Signals s = {0};
    plat_mutex_lock(&m->mu);
    // only a buffer the client holds (handed out, not yet sent): one that is free or queued would be returned twice
    // and overflow in_free (after a Flush refilled it, say)
    int held = 1;
    for (int i = 0; i < m->nin_free; i++) held &= m->in_free[i] != index;
    for (int i = 0; i < m->npending; i++) held &= m->pending[i].index != index;
    int st = ST_OK;
    if (!m->started || m->npending == IN_BUFS || !held) st = ST_ERROR;
    else if (m->eos_in) {   // after end of stream: hand the buffer back
        m->in_free[m->nin_free++] = index;
        m->owed |= 1u << MOVIE_EV_INPUT;
    } else {
        m->pending[m->npending++] = (Pending){index, offset, size, time, flags};
        m->fed_in++;
        plat_cond_signal(&m->work);
    }
    collect(m, &s);
    plat_mutex_unlock(&m->mu);
    fire(c, &s);
    ret_x(c, (uint32_t)st);
}

// Status AcquireOutputBufferIndex(int *index, long *time, unsigned *flags, int *remaining)
static void ov_acquire_output(Cpu *c) {
    int *index = arg_p(c, 1), *remaining = arg_p(c, 4);
    int64_t *time = arg_p(c, 2);
    unsigned *flags = arg_p(c, 3);
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_ACQUIRE_OUTPUT); return; }
    if (!index || !time || !flags || !remaining) { ret_x(c, ST_NULL); return; }
    Signals s = {0};
    plat_mutex_lock(&m->mu);   // paced frames become ready only at presents (movie_tick)
    *index = -1;
    *time = 0;
    *flags = 0;
    *remaining = 0;
    if (m->nready == 0 && m->ndecoded > 0 && (m->decoded[0].flags & MOVIE_FLAG_EOS)) {
        // EOS is due as soon as it is first in line: hand it over on the
        // acquiring thread so the game never waits on a post-EOS present.
        m->ready[m->nready++] = m->decoded[0];
        memmove(m->decoded, m->decoded + 1, (size_t)--m->ndecoded * sizeof *m->decoded);
        m->st.handed++;
        m->owed |= 1u << MOVIE_EV_OUTPUT;
        rt_log("movie: EOS drained via acquire (handed=%llu)", (unsigned long long)m->st.handed);
    }
    int st = ST_NO_OUTPUT;
    if (m->nready > 0) {
        Ready r = m->ready[0];
        memmove(m->ready, m->ready + 1, (size_t)--m->nready * sizeof *m->ready);
        *index = r.index;
        *time = r.time;
        *flags = r.flags;
        *remaining = m->nready;
        st = ST_OK;
        if (r.flags & MOVIE_FLAG_EOS)
            rt_log("movie: game acquired EOS frame (index=%d, remaining=%d)", r.index, m->nready);
    }
    {   // temporary EOS-hang diagnosis: how often does the game poll after the end of stream?
        static int nacq = 0;
        if (m->eos_in && ((++nacq % 600) == 0))
            rt_log("movie: %d output polls since EOS (ready=%d, held0=%d)", nacq, m->nready, m->out_held[0]);
    }
    collect(m, &s);
    plat_mutex_unlock(&m->mu);
    fire(c, &s);
    ret_x(c, (uint32_t)st);
}

static int get_output(Cpu *c, Movie *m, int index, uint64_t buf) {
    buf_set_range(c, buf, 0, 0);
    uint8_t *dst = (uint8_t *)(uintptr_t)rt_call(c, G.buf_base, 1, buf);
    uint64_t cap = rt_call(c, G.buf_capacity, 1, buf);
    int st = ST_ERROR, bytes = 0;
    plat_mutex_lock_shared(&m->mu);
    if (index >= 0 && index < OUT_BUFS && m->out_held[index]) {
        bytes = m->out_bytes[index];
        if (!bytes) st = ST_OK;
        else if (dst && cap >= (uint64_t)bytes) {
            memcpy(dst, m->out[index], (size_t)bytes);
            st = ST_OK;
        } else {
            rt_log("movie: output buffer of %llu bytes for a %d-byte frame", (unsigned long long)cap, bytes);
            bytes = 0;
        }
    }
    plat_mutex_unlock_shared(&m->mu);
    if (st == ST_OK && bytes) buf_set_range(c, buf, 0, bytes);
    return st;
}

// Status GetOutputBuffer(int index, Buffer *buffer)
static void ov_get_output(Cpu *c) {
    int index = (int)arg_x(c, 1);
    rt_log("movie: GetOutputBuffer(%d)", index);
    uint64_t buf = arg_x(c, 2);
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_GET_OUTPUT); return; }
    ret_x(c, buf ? (uint32_t)get_output(c, m, index, buf) : ST_NULL);
}

// Status GetOutputBufferSize(int *size, int *count)
static void ov_get_output_size(Cpu *c) {
    int *size = arg_p(c, 1), *count = arg_p(c, 2);
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_GET_OUTPUT_SIZE); return; }
    if (!size || !count) { ret_x(c, ST_NULL); return; }
    plat_mutex_lock_shared(&m->mu);
    *count = 1;
    *size = m->configured ? frame_bytes(m) : 0;
    plat_mutex_unlock_shared(&m->mu);
    ret_x(c, ST_OK);
}

// Status ReleaseOutputBufferIndex(int index)
static void ov_release_output(Cpu *c) {
    int index = (int)arg_x(c, 1);
    rt_log("movie: ReleaseOutputBufferIndex(%d)", index);
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_RELEASE_OUTPUT); return; }
    Signals s = {0};
    plat_mutex_lock(&m->mu);
    int st = ST_ERROR;
    if (index >= 0 && index < OUT_BUFS && m->out_held[index]) {
        int queued = 0;
        for (int i = 0; i < m->nready; i++) queued |= m->ready[i].index == index;
        for (int i = 0; i < m->ndecoded; i++) queued |= m->decoded[i].index == index;
        if (!queued) {
            m->out_held[index] = 0;
            plat_cond_signal(&m->work);
            st = ST_OK;
        }
    }
    collect(m, &s);
    plat_mutex_unlock(&m->mu);
    fire(c, &s);
    ret_x(c, (uint32_t)st);
}

static void ov_get_last_error(Cpu *c) {
    Movie *m = find(arg_x(c, 0));
    rt_log("movie: GetLastError");
    if (!m) { pass(c, MOVIE_GET_LAST_ERROR); return; }
    plat_mutex_lock_shared(&m->mu);
    int e = m->last_error;
    plat_mutex_unlock_shared(&m->mu);
    ret_x(c, (uint32_t)e);
}

static int output_format(Cpu *c, Movie *m, int index, uint64_t md) {
    plat_mutex_lock_shared(&m->mu);
    int ok = index >= 0 && index < OUT_BUFS && m->out_held[index], w = m->w, h = m->h;
    plat_mutex_unlock_shared(&m->mu);
    if (!ok) return ST_ERROR;
    set_format(c, w, h, md);
    return ST_OK;
}

// Status GetOutputBufferFormat(int index, MediaData *format)
static void ov_get_output_buffer_format(Cpu *c) {
    int index = (int)arg_x(c, 1);
    uint64_t md = arg_x(c, 2);
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_GET_OUTPUT_BUFFER_FORMAT); return; }
    ret_x(c, md ? (uint32_t)output_format(c, m, index, md) : ST_NULL);
}

// Status GetOutputBuffer(int index, Buffer *buffer, MediaData *format)
static void ov_get_output_md(Cpu *c) {
    int index = (int)arg_x(c, 1);
    uint64_t buf = arg_x(c, 2), md = arg_x(c, 3);
    Movie *m = find(arg_x(c, 0));
    if (!m) { pass(c, MOVIE_GET_OUTPUT_MD); return; }
    if (!buf && !md) { ret_x(c, ST_NULL); return; }
    int st = md ? output_format(c, m, index, md) : ST_OK;
    if (st == ST_OK && buf) st = get_output(c, m, index, buf);
    ret_x(c, (uint32_t)st);
}

HOST_OVERRIDE("_ZN5movie7DecoderC1ENS_11DecoderTypeENS_19DecoderOutputFormatE", ov_ctor);
// main imports C1; C2 is the same code (no virtual bases).
HOST_OVERRIDE("_ZN5movie7DecoderC2ENS_11DecoderTypeENS_19DecoderOutputFormatE", ov_ctor);
// SDK 3.x titles declare the constructor with a mode and a priority; the first two arguments are unchanged.
