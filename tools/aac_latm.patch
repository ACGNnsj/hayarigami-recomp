+// ---- Media Foundation AAC (audio, LATM/LOAS -> ADTS) ----
+// The audio track arrives as LATM AudioMuxElements, usually inside the 3-byte
+// LOAS sync layer; the AAC MFT only takes ADTS, so every packet is reframed:
+// LOAS/LATM headers are stripped to the raw frame and a 7-byte ADTS header
+// (built from the AudioSpecificConfig) is prepended. The ASC rides in the first
+// StreamMuxConfig; until one parses, the esds ASC (AAC-LC, 48 kHz, stereo)
+// is the default. Decoded PCM goes through the normal out[] slots, so the game
+// acquires and plays it and the audio side drains on its own.
+#define AAC_PCM_CAP (32768)
+static const int aac_freq_table[13] = { 96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350 };
+static void mf_startup(void);
+static int aac_freq_idx(int rate) {
+    int best = 3, bd = 0x7fffffff;
+    for (int i = 0; i < 13; i++) { int d = rate - aac_freq_table[i]; if (d < 0) d = -d; if (d < bd) { bd = d; best = i; } }
+    return best;
+}
+typedef struct { const uint8_t *p, *end; unsigned bit; } AacBits;
+static int aac_get(AacBits *b, int n) {
+    unsigned v = 0;
+    for (int i = 0; i < n; i++) {
+        if (b->p >= b->end) return -1;
+        v = (v << 1) | (unsigned)((b->p[0] >> (7 - b->bit)) & 1);
+        if (++b->bit == 8) { b->p++; b->bit = 0; }
+    }
+    return (int)v;
+}
+static int aac_loas(const uint8_t *d, size_t n, const uint8_t **pay, size_t *paylen) {
+    if (n < 3 || d[0] != 0x56 || (d[1] & 0xF0) != 0xE0) return 0;
+    size_t len = ((size_t)(d[1] & 0x1F) << 8) | d[2];
+    if (len == 0 || 3 + len > n) return 0;
+    *pay = d + 3; *paylen = len;
+    return 1;
+}
+static int aac_smc_full(AacBits *b, int *profile, int *freq_idx, int *ch) {
+    if (aac_get(b, 1) != 0) return 0;
+    if (aac_get(b, 1) != 1) return 0;
+    if (aac_get(b, 6) != 0) return 0;
+    if (aac_get(b, 4) != 0) return 0;
+    if (aac_get(b, 3) != 0) return 0;
+    if (aac_get(b, 1) != 0) return 0;
+    int aot = aac_get(b, 5);
+    if (aot == 31) { int e = aac_get(b, 6); if (e < 0) return 0; aot = 32 + e; }
+    if (aot <= 0 || aot > 32) return 0;
+    int fi = aac_get(b, 4);
+    if (fi < 0 || fi > 12) {
+        if (fi != 15) return 0;
+        for (int i = 0; i < 24; i++) if (aac_get(b, 1) < 0) return 0;
+        fi = 3;
+    }
+    int cfg = aac_get(b, 4);
+    if (cfg < 0) return 0;
+    int flen = aac_get(b, 1), dep = aac_get(b, 1), extf = aac_get(b, 1);
+    if (flen < 0 || dep < 0 || extf < 0) return 0;
+    if (dep) { if (aac_get(b, 14) < 0) return 0; }
+    *profile = aot; *freq_idx = fi; *ch = cfg;
+    return 1;
+}
+static int aac_short(AacBits *b) {
+    if (aac_get(b, 1) != 0) return 0;
+    if (aac_get(b, 1) != 1) return 0;
+    if (aac_get(b, 6) != 0) return 0;
+    if (aac_get(b, 4) != 0) return 0;
+    if (aac_get(b, 3) != 0) return 0;
+    if (aac_get(b, 1) != 1) return 0;
+    return 1;
+}
+static int aac_reframe(Movie *m, const uint8_t *d, size_t n, const uint8_t **raw, size_t *rawlen) {
+    const uint8_t *p = d; size_t left = n;
+    const uint8_t *lp; size_t llen;
+    if (aac_loas(d, n, &lp, &llen)) { p = lp; left = llen; }
+    if (!m->aac_smc_done) {
+        AacBits b = { p, p + left, 0 };
+        int prof = 0, fi = 0, ch = 0;
+        if (aac_smc_full(&b, &prof, &fi, &ch)) {
+            m->aac_profile = prof; m->aac_freq_idx = fi; m->aac_ch = ch ? ch : 2;
+            m->aac_rate = aac_freq_table[fi < 0 || fi > 12 ? 3 : fi];
+            m->aac_smc_done = 1;
+            if (b.bit) { b.p++; b.bit = 0; }
+            if (b.p >= b.end) return 0;
+            *raw = b.p; *rawlen = (size_t)(b.end - b.p);
+            rt_log("movie: AAC StreamMuxConfig: profile %d, %d Hz, %d channels", prof, m->aac_rate, m->aac_ch);
+            return 1;
+        }
+    } else {
+        AacBits b = { p, p + left, 0 };
+        if (aac_short(&b)) {
+            if (b.bit) { b.p++; b.bit = 0; }
+            if (b.p < b.end) { *raw = b.p; *rawlen = (size_t)(b.end - b.p); return 1; }
+        }
+    }
+    *raw = p; *rawlen = left;
+    return left > 0;
+}
+static void aac_adts(uint8_t h[7], int profile, int freq_idx, int ch, size_t len) {
+    size_t full = len + 7;
+    h[0] = 0xFF; h[1] = 0xF1;
+    h[2] = (uint8_t)(((profile & 3) << 6) | ((freq_idx & 15) << 2) | ((ch >> 2) & 1));
+    h[3] = (uint8_t)(((ch & 3) << 6) | ((full >> 11) & 3));
+    h[4] = (uint8_t)((full >> 3) & 0xFF);
+    h[5] = (uint8_t)(((full & 7) << 5) | 0x1F);
+    h[6] = 0xFC;
+}
+static IMFMediaType *aac_make_in(int rate, int ch, int aot, int fi) {
+    IMFMediaType *t = NULL;
+    if (FAILED(MFCreateMediaType(&t))) return NULL;
+    uint8_t asc[2];
+    asc[0] = (uint8_t)(((aot & 31) << 3) | ((fi & 15) >> 1));
+    asc[1] = (uint8_t)((((fi & 1) << 7) | ((ch & 15) << 3)) & 0xFF);
+    HRESULT hr = t->lpVtbl->SetGUID(t, &MF_MT_MAJOR_TYPE, &MFMediaType_Audio);
+    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetGUID(t, &MF_MT_SUBTYPE, &MFAudioFormat_AAC);
+    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT32(t, &MF_MT_AAC_PAYLOAD_TYPE, 0);
+    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT32(t, &MF_MT_AUDIO_NUM_CHANNELS, (UINT32)ch);
+    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT32(t, &MF_MT_AUDIO_SAMPLES_PER_SECOND, (UINT32)rate);
+    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetBlob(t, &MF_MT_USER_DATA, asc, 2);
+    if (FAILED(hr)) { t->lpVtbl->Release(t); return NULL; }
+    return t;
+}
+static IMFMediaType *aac_make_out(int rate, int ch) {
+    IMFMediaType *t = NULL;
+    if (FAILED(MFCreateMediaType(&t))) return NULL;
+    HRESULT hr = t->lpVtbl->SetGUID(t, &MF_MT_MAJOR_TYPE, &MFMediaType_Audio);
+    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetGUID(t, &MF_MT_SUBTYPE, &MFAudioFormat_PCM);
+    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT32(t, &MF_MT_AUDIO_NUM_CHANNELS, (UINT32)ch);
+    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT32(t, &MF_MT_AUDIO_SAMPLES_PER_SECOND, (UINT32)rate);
+    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT32(t, &MF_MT_AUDIO_BITS_PER_SAMPLE, 16);
+    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT32(t, &MF_MT_AUDIO_BLOCK_ALIGNMENT, (UINT32)(ch * 2));
+    if (SUCCEEDED(hr)) hr = t->lpVtbl->SetUINT32(t, &MF_MT_AUDIO_AVG_BYTES_PER_SECOND, (UINT32)(rate * ch * 2));
+    if (FAILED(hr)) { t->lpVtbl->Release(t); return NULL; }
+    return t;
+}
+static int aac_open(Movie *m) {
+    mf_startup();
+    HRESULT hr = CoCreateInstance(&CLSID_CMSAACDecMFT, NULL, CLSCTX_INPROC_SERVER, &IID_IMFTransform, (void **)&m->aac);
+    if (FAILED(hr) || !m->aac) {
+        rt_log("movie: AAC MFT creation: %#lx", (unsigned long)hr);
+        return 0;
+    }
+    m->aac_live = 1;
+    return 1;
+}
+static void aac_probe_types(Movie *m) {
+    for (int i = 0; i < 4; i++) {
+        IMFMediaType *t = NULL;
+        HRESULT hr = m->aac->lpVtbl->GetInputAvailableType(m->aac, 0, i, &t);
+        if (FAILED(hr) || !t) { rt_log("movie: AAC avail_in[%d]: %#lx", i, (unsigned long)hr); continue; }
+        GUID sub = {0}; UINT32 pay = 99, ch = 0, rate = 0, bits = 0, ulen = 0;
+        t->lpVtbl->GetGUID(t, &MF_MT_SUBTYPE, &sub);
+        t->lpVtbl->GetUINT32(t, &MF_MT_AAC_PAYLOAD_TYPE, &pay);
+        t->lpVtbl->GetUINT32(t, &MF_MT_AUDIO_NUM_CHANNELS, &ch);
+        t->lpVtbl->GetUINT32(t, &MF_MT_AUDIO_SAMPLES_PER_SECOND, &rate);
+        t->lpVtbl->GetUINT32(t, &MF_MT_AUDIO_BITS_PER_SAMPLE, &bits);
+        uint8_t *ub = NULL; UINT32 usz = 0;
+        if (SUCCEEDED(t->lpVtbl->GetAllocatedBlob(t, &MF_MT_USER_DATA, &ub, &usz))) { ulen = usz; CoTaskMemFree(ub); }
+        rt_log("movie: AAC avail_in[%d]: sub=%08lx pay=%u ch=%u rate=%u bits=%u user=%u", i, (unsigned long)sub.Data1, pay, ch, rate, bits, ulen);
+        t->lpVtbl->Release(t);
+    }
+}
+static HRESULT aac_negotiate_in(Movie *m, int aot, int fi) {
+    uint8_t asc[2];
+    asc[0] = (uint8_t)(((aot & 31) << 3) | ((fi & 15) >> 1));
+    asc[1] = (uint8_t)((((fi & 1) << 7) | ((m->aac_ch & 15) << 3)) & 0xFF);
+    for (int v = 0; v < 4; v++) {
+        IMFMediaType *t = NULL;
+        HRESULT hr = E_FAIL;
+        if (v < 2) {
+            if (FAILED(m->aac->lpVtbl->GetInputAvailableType(m->aac, 0, 0, &t))) continue;
+            if (v == 0) {
+                t->lpVtbl->SetUINT32(t, &MF_MT_AUDIO_NUM_CHANNELS, (UINT32)m->aac_ch);
+                t->lpVtbl->SetUINT32(t, &MF_MT_AUDIO_SAMPLES_PER_SECOND, (UINT32)m->aac_rate);
+            }
+            if (v == 1) t->lpVtbl->SetBlob(t, &MF_MT_USER_DATA, asc, 2);
+        } else if (v == 2) {
+            t = aac_make_in(m->aac_rate, m->aac_ch, aot, fi);
+            if (t) t->lpVtbl->SetUINT32(t, &MF_MT_AUDIO_BITS_PER_SAMPLE, 32);
+        } else {
+            if (FAILED(m->aac->lpVtbl->GetInputAvailableType(m->aac, 0, 0, &t))) continue;
+        }
+        if (!t) continue;
+        hr = m->aac->lpVtbl->SetInputType(m->aac, 0, t, 0);
+        t->lpVtbl->Release(t);
+        rt_log("movie: AAC in-variant v%d: %#lx", v, (unsigned long)hr);
+        if (SUCCEEDED(hr)) return hr;
+    }
+    return E_FAIL;
+}
+static void aac_configure_mft(Movie *m) {
+    aac_probe_types(m);
+    int aot = m->aac_smc_done ? m->aac_profile : 2;
+    int fi = m->aac_smc_done ? m->aac_freq_idx : aac_freq_idx(m->aac_rate);
+    HRESULT hr_in = aac_negotiate_in(m, aot, fi);
+    IMFMediaType *out = SUCCEEDED(hr_in) ? aac_make_out(m->aac_rate, m->aac_ch) : NULL;
+    HRESULT hr_out = out ? m->aac->lpVtbl->SetOutputType(m->aac, 0, out, 0) : E_OUTOFMEMORY;
+    if (out) out->lpVtbl->Release(out);
+    if (SUCCEEDED(hr_in) && SUCCEEDED(hr_out)) {
+        m->aac->lpVtbl->ProcessMessage(m->aac, MFT_MESSAGE_NOTIFY_BEGIN_STREAMING, 0);
+        m->aac->lpVtbl->ProcessMessage(m->aac, MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0);
+        m->aac_ready = 1;
+        rt_log("movie: AAC decoding %d Hz x%d", m->aac_rate, m->aac_ch);
+    } else {
+        m->aac_broken = 1;
+        rt_log("movie: AAC setup: input %#lx output %#lx", (unsigned long)hr_in, (unsigned long)hr_out);
+    }
+}
+static void aac_close(Movie *m) {
+    if (m->aac) {
+        m->aac->lpVtbl->ProcessMessage(m->aac, MFT_MESSAGE_COMMAND_FLUSH, 0);
+        m->aac->lpVtbl->Release(m->aac);
+        m->aac = NULL;
+    }
+    m->aac_live = m->aac_ready = m->aac_broken = m->aac_fed_first = m->aac_smc_done = 0;
+}
+static HRESULT aac_in(Movie *m, const uint8_t *d, size_t n, int64_t time_us) {
+    IMFMediaBuffer *buf = NULL;
+    IMFSample *s = NULL;
+    HRESULT hr = MFCreateMemoryBuffer((DWORD)n, &buf);
+    if (SUCCEEDED(hr)) {
+        BYTE *p = NULL;
+        hr = buf->lpVtbl->Lock(buf, &p, NULL, NULL);
+        if (SUCCEEDED(hr)) {
+            memcpy(p, d, n);
+            hr = buf->lpVtbl->Unlock(buf);
+        }
+    }
+    if (SUCCEEDED(hr)) hr = buf->lpVtbl->SetCurrentLength(buf, (DWORD)n);
+    if (SUCCEEDED(hr)) hr = MFCreateSample(&s);
+    if (SUCCEEDED(hr)) hr = s->lpVtbl->AddBuffer(s, buf);
+    if (SUCCEEDED(hr) && time_us > 0) hr = s->lpVtbl->SetSampleTime(s, time_us * 10);
+    if (SUCCEEDED(hr)) hr = m->aac->lpVtbl->ProcessInput(m->aac, 0, s, 0);
+    if (SUCCEEDED(hr)) m->aac_fed_first = 1;
+    if (s) s->lpVtbl->Release(s);
+    if (buf) buf->lpVtbl->Release(buf);
+    return hr;
+}
+static HRESULT aac_out(Movie *m, uint8_t *dst, size_t cap, int *got) {
+    *got = 0;
+    MFT_OUTPUT_STREAM_INFO oi;
+    memset(&oi, 0, sizeof oi);
+    if (FAILED(m->aac->lpVtbl->GetOutputStreamInfo(m->aac, 0, &oi))) return E_FAIL;
+    for (int k = 0; k < 4; k++) {
+        MFT_OUTPUT_DATA_BUFFER ob;
+        DWORD st = 0;
+        IMFSample *own = NULL;
+        IMFMediaBuffer *ownb = NULL;
+        memset(&ob, 0, sizeof ob);
+        if (!(oi.dwFlags & MFT_OUTPUT_STREAM_PROVIDES_SAMPLES)) {
+            DWORD need = oi.cbSize ? oi.cbSize : 32768;
+            if (SUCCEEDED(MFCreateSample(&own)) && SUCCEEDED(MFCreateMemoryBuffer(need, &ownb)) &&
+                SUCCEEDED(own->lpVtbl->AddBuffer(own, ownb)))
+                ob.pSample = own;
+        }
+        HRESULT hr = m->aac->lpVtbl->ProcessOutput(m->aac, 0, 1, &ob, &st);
+        if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT) {
+            if (own) own->lpVtbl->Release(own);
+            if (ownb) ownb->lpVtbl->Release(ownb);
+            return S_OK;
+        }
+        if (FAILED(hr)) {
+            if (own) own->lpVtbl->Release(own);
+            if (ownb) ownb->lpVtbl->Release(ownb);
+            return hr;
+        }
+        IMFMediaBuffer *out = NULL;
+        if (ob.pSample) {
+            if (own) { out = ownb; ownb = NULL; }
+            else ob.pSample->lpVtbl->ConvertToContiguousBuffer(ob.pSample, &out);
+        }
+        if (out) {
+            BYTE *p = NULL; DWORD cur = 0;
+            if (SUCCEEDED(out->lpVtbl->Lock(out, &p, NULL, &cur))) {
+                size_t take = cur;
+                if (take > cap) take = cap;
+                memcpy(dst, p, take);
+                *got = (int)take;
+                out->lpVtbl->Unlock(out);
+            }
+            out->lpVtbl->Release(out);
+        }
+        if (ob.pSample) ob.pSample->lpVtbl->Release(ob.pSample);
+        if (ownb) ownb->lpVtbl->Release(ownb);
+        if (*got) return S_OK;
+    }
+    return S_OK;
+}
